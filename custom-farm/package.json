{
  "name": "@lily-cooperative/custom-farm",
  "version": "0.37.0",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "自定义农场（Custom Farm）—— 给 Coopanion 桌宠的种田扩展：18 种作物只是起点。农作物、杂草、装饰物、天气、状态、道具、合成表和贴图都能在面板里完全自定义；种、浇、收、吃、买卖都由你决定。",
  "keywords": [
    "cortico-world",
    "coopanion",
    "farm",
    "种田",
    "自定义农场",
    "customizable"
  ],
  "license": "MIT",
  "author": {
    "name": "lily_cooperative",
    "email": "lily_cooperative@users.noreply.github.com",
    "url": "https://github.com/LilyCooperative"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyCooperative/Coopanion_Custom_Farm.git",
    "directory": "custom-farm"
  },
  "homepage": "https://github.com/LilyCooperative/Coopanion_Custom_Farm#readme",
  "bugs": {
    "url": "https://github.com/LilyCooperative/Coopanion_Custom_Farm/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "dist",
    "overlay",
    "overlay-electron",
    "assets",
    "icon.png",
    "describe.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node tools/pack-prepare.mjs",
    "postpack": "node tools/pack-clean.mjs"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "自定义农场",
    "locales": {
      "zh": {
        "displayName": "自定义农场",
        "description": "18 种作物只是起点：农作物、杂草、装饰物、天气、状态、道具、合成表和贴图都能在面板里完全自定义，想种什么、长什么样、吃什么补什么，全由你决定。"
      },
      "en": {
        "displayName": "Custom Farm",
        "description": "18 crops are just the beginning: crops, weeds, decorations, weather, states, items, recipes and sprites are all fully customizable in the panel. Plant, water, harvest, eat and trade the way you like."
      }
    },
    "tags": [
      "game",
      "companion",
      "internal-state",
      "experimental"
    ],
    "describe": "describe.json",
    "icon": "icon.png",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  },
  "dependencies": {
    "electron": "^45.1.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ]
}
